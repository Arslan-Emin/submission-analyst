# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM (DeepSeek, OpenAI-compatible Chat Completions API) ---
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-flash
# enabled = model reasons before answering (slower, more tokens); disabled = faster, cheaper
DEEPSEEK_THINKING=disabled

# --- Data source: fixture (synthetic, offline; default), jotform (live REST API)
#     or mcp (Jotform MCP server; run `python -m analyst.sources.jotform_mcp login` once) ---
DATA_SOURCE=fixture

# --- Jotform (only needed when DATA_SOURCE=jotform) ---
JOTFORM_API_KEY=
JOTFORM_FORM_ID=
# Use https://eu-api.jotform.com for EU accounts
JOTFORM_BASE_URL=https://api.jotform.com

# --- Tracing (JSONL events for every LLM call, SQL run and question) ---
TRACE_ENABLED=true
TRACE_DIR=logs/traces
# Include question text, generated SQL and results (may contain personal data)
TRACE_INCLUDE_CONTENT=false
# Optional: also send events to the eval platform (github.com/Arslan-Emin/llm-eval-platform),
# e.g. http://127.0.0.1:8700/v1/events while `evalplat serve` runs. Empty = files only.
TRACE_HTTP_URL=
TRACE_HTTP_TOKEN=
